# ─────────────────────────────────────────────────────────────
#  THE MONEY CIRCLE · copy to .env.local and fill in
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for Paystack callback + admin approve links)
SITE_URL=http://localhost:3000

# Secret for /admin (manual bank-transfer approvals). Use a long random string.
ADMIN_SECRET=

# ── Paystack ────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Use sk_test_... until you go live.
PAYSTACK_SECRET_KEY=
# Optional: recurring Academy subscriptions (Dashboard → Products → Plans)
PAYSTACK_PLAN_ACADEMY_MONTHLY=
PAYSTACK_PLAN_ACADEMY_ANNUAL=

# Local dev only: webhooks can't reach localhost, so onboard from the success page.
ONBOARD_ON_CALLBACK=false

# ── Google (Drive vaults + Gmail + Sheets ledger) ────────────
# Create an OAuth client of type "Desktop app", then run: npm run google:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Folder that will hold every client's vault (ID = last part of the folder URL)
VAULTS_PARENT_FOLDER_ID=

# Master template folders to duplicate per package
VAULT_TEMPLATE_WEALTH_ID=
VAULT_TEMPLATE_LAUNCHPAD_ID=
VAULT_TEMPLATE_FULL_ID=

# Google Sheet used as your student ledger + duplicate protection
ENROLLMENTS_SHEET_ID=
ENROLLMENTS_SHEET_TAB=Enrollments

# ── Email ───────────────────────────────────────────────────
# gmail (send from your Google account) | resend | console (prints to terminal)
EMAIL_PROVIDER=gmail
EMAIL_FROM=
EMAIL_FROM_NAME=Your Money Buddy
EMAIL_REPLY_TO=
RESEND_API_KEY=
# Where "New student payment received!" alerts go
ADMIN_EMAIL=

# ── Booking links (Calendly etc.) ────────────────────────────
BOOKING_WEALTH_URL=
BOOKING_LAUNCHPAD_URL=
BOOKING_VIP_URL=
ACADEMY_CALLS_URL=
ACADEMY_PORTAL_URL=

# ── Community invite links (WhatsApp group/community links) ──
COMMUNITY_ACADEMY_URL=
COMMUNITY_WEALTH_URL=
COMMUNITY_LAUNCHPAD_URL=
COMMUNITY_VIP_URL=

# ── Telegram (optional) ─────────────────────────────────────
# If a TELEGRAM_CHAT_* id is set, students get a single-use invite link instead of the shared URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHAT_ACADEMY=
TELEGRAM_CHAT_WEALTH=
TELEGRAM_CHAT_LAUNCHPAD=
TELEGRAM_CHAT_VIP=

# ── Direct bank transfer details shown at checkout (optional) ─
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# ── Public site details ─────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FREE_COMMUNITY_URL=

# ── Student app ─────────────────────────────────────────────
# demo = simulated checkout (no money moves) | paystack = real Paystack
PAYMENT_MODE=demo
# Long random string that signs student login cookies (required in production)
AUTH_SECRET=
# Leave empty for a local SQLite file (./data/tmc.db). In production use Turso:
DATABASE_URL=
DATABASE_AUTH_TOKEN=
